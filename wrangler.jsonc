{
  "name": "resort-booking",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "resort", "database_id": "78ca55fd-69dc-472c-80bf-638f823d8545" }
  ],
  "triggers": { "crons": ["30 12 * * *"] },
  "vars": { "APP_URL": "", "CURRENCY": "INR", "MAIL_FROM": "Resort <bookings@example.com>", "RESORT_NAME": "Your Resort" }
}
